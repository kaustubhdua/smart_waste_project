# Copy to .env and replace every placeholder before starting.
# In production API_TOKEN is used only for one-time first-admin bootstrap, not daily sign-in.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_TOKEN=replace-with-a-long-random-bootstrap-secret
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
# Production alternative: ROUTING_PROVIDER=ors, ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2, ORS_API_KEY=<managed secret>
ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2
ORS_API_KEY=

# No synthetic records are created unless explicitly opted in for a demo.
# Set true only when you intentionally want labeled demonstration records.
SEED_DEMO_DATA=false
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Bind published ports to loopback by default; place a TLS reverse proxy in front for deployments.
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
