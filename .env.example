# Copy to .env and replace every placeholder before starting.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_TOKEN=replace-with-a-long-random-operator-token
OSRM_BASE_URL=https://router.project-osrm.org

# Seeds explicitly labeled demo bins, telemetry and vehicles for local development.
# Set false for a clean/live deployment.
SEED_DEMO_DATA=true
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
